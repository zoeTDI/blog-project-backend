<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.caldm.www.post_context.infrastructure.persistence.mapper.BlogPostCategoryRelationMapper">
    <insert id="insertBatch" parameterType="list">
        INSERT INTO blog_post_category_relation (post_id, category_id, is_direct)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.postId}, #{item.categoryId},
            <choose>
                <when test="item.isDirect != null">#{item.isDirect}</when>
                <otherwise>1</otherwise>
            </choose>)
        </foreach>
    </insert>
</mapper>
